{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A Share Theme Chain",
  "type": "object",
  "required": ["symbol", "themes", "industry_chain", "scores", "components", "evidence", "insufficient_data", "verdict"],
  "properties": {
    "symbol": { "type": ["string", "null"] },
    "name": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "methodology": { "type": "string" },
    "sources": { "type": "object" },
    "system_change": { "type": "string" },
    "themes": { "type": "array" },
    "industry_chain": { "type": "array" },
    "layer_ranking": { "type": "array" },
    "candidate_universe": { "type": "array" },
    "priority_research_list": { "type": "array" },
    "fund_directions": { "type": "array" },
    "lower_priority_popular_areas": { "type": "array" },
    "next_checks": { "type": "array" },
    "scores": {
      "type": "object",
      "required": ["theme", "risk"],
      "properties": {
        "theme": { "type": "number", "minimum": 0, "maximum": 5 },
        "risk": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "components": { "type": "array" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "insufficient_data": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verdict": { "type": "string" }
  }
}
