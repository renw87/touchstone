{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A Share Backtest Summary",
  "type": "object",
  "required": ["symbol", "rule", "period", "metrics", "failed_samples", "insufficient_data", "verdict"],
  "properties": {
    "symbol": { "type": ["string", "null"] },
    "name": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "source_market_data": { "type": "string" },
    "rule": { "type": "object" },
    "period": {
      "type": "object",
      "required": ["start", "end", "bar_count"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "bar_count": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["trade_count", "win_rate", "profit_factor", "max_drawdown", "total_return"],
      "properties": {
        "trade_count": { "type": "integer", "minimum": 0 },
        "win_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "profit_factor": { "type": ["number", "null"] },
        "max_drawdown": { "type": "number", "minimum": 0 },
        "total_return": { "type": "number" }
      }
    },
    "trades": { "type": "array" },
    "failed_samples": { "type": "array" },
    "insufficient_data": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verdict": { "type": "string" }
  }
}
