{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A Share Fundamental Score",
  "type": "object",
  "required": ["symbol", "scores", "components", "evidence", "insufficient_data", "verdict"],
  "properties": {
    "symbol": { "type": ["string", "null"] },
    "name": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "source_financials": { "type": "string" },
    "latest_report_period": { "type": "string" },
    "scores": {
      "type": "object",
      "required": ["fundamental", "risk"],
      "properties": {
        "fundamental": { "type": "number", "minimum": 0, "maximum": 5 },
        "risk": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "components": { "type": "array" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "insufficient_data": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verdict": { "type": "string" }
  }
}
